# Agent: Data & ORM Configuration

# Database provider configuration
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

# Enums
enum UserRole {
  user
  admin
}

enum EventType {
  event
  workshop
}

# Core Models

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String?
  email     String?
  role      UserRole @default(user)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  blogPosts BlogPost[]
  leads     Lead[]

  @@map("users")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  venue       String
  location    String
  date        String
  month       String
  time        String
  image       String
  ticketUrl   String    @map("ticket_url")
  eventType   EventType @default(event) @map("event_type")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("events")
}

model BlogPost {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  content       String
  excerpt       String
  featuredImage String   @map("featured_image")
  authorId      Int?     @map("author_id")
  published     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  author User? @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model SiteSettings {
  id        Int      @id @default(autoincrement())
  section   String
  settings  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Ebook {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  coverImage  String   @map("cover_image")
  price       String
  salePrice   String?  @map("sale_price")
  buyLink     String   @map("buy_link")
  features    Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  purchases EbookPurchase[]

  @@map("ebooks")
}

model HeroSettings {
  id              Int      @id @default(autoincrement())
  title           String
  subtitle        String?
  backgroundImage String   @map("background_image")
  buttonText1     String?  @map("button_text_1")
  buttonLink1     String?  @map("button_link_1")
  buttonText2     String?  @map("button_text_2")
  buttonLink2     String?  @map("button_link_2")
  imagePosition   String   @default("center center") @map("image_position")
  imageScale      Float    @default(1.0) @map("image_scale")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("hero_settings")
}

model Interview {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  embedUrl       String   @map("embed_url")
  thumbnailImage String?  @map("thumbnail_image")
  imagePosition  String   @default("center center") @map("image_position")
  imageScale     Float    @default(1.0) @map("image_scale")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("interviews")
}

model EbookPurchase {
  id               Int       @id @default(autoincrement())
  ebookId          Int       @map("ebook_id")
  name             String
  lastName         String    @map("last_name")
  email            String
  purchaseDate     DateTime  @default(now()) @map("purchase_date")
  paymentReference String?   @map("payment_reference")
  delivered        Boolean   @default(false)
  deliveryDate     DateTime? @map("delivery_date")
  paidAmount       String?   @map("paid_amount")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  ebook Ebook @relation(fields: [ebookId], references: [id])

  @@map("ebook_purchases")
}

# Agent: Leads API - New Lead Management Models

enum LeadStatus {
  new
  contacted
  qualified
  proposal
  negotiation
  closed_won
  closed_lost
  nurturing
}

enum LeadSource {
  website
  social_media
  referral
  advertising
  trade_show
  cold_call
  email_campaign
  partner
  organic_search
  paid_search
  other
}

enum LeadPriority {
  low
  medium
  high
  urgent
}

model Lead {
  id                Int          @id @default(autoincrement())
  // Basic Information
  firstName         String       @map("first_name")
  lastName          String       @map("last_name")
  email             String       @unique
  phone             String?
  company           String?
  jobTitle          String?      @map("job_title")
  
  // Lead Details
  status            LeadStatus   @default(new)
  source            LeadSource   @default(website)
  priority          LeadPriority @default(medium)
  
  // Qualification Information
  budget            Float?
  expectedCloseDate DateTime?    @map("expected_close_date")
  probability       Int?         // Percentage (0-100)
  
  // Contact Information
  address           String?
  city              String?
  state             String?
  zipCode           String?      @map("zip_code")
  country           String?
  website           String?
  
  // Additional Information
  notes             String?
  tags              String[] // Array of tags for categorization
  customFields      Json?        @map("custom_fields") // Flexible additional data
  
  // AI Scoring (Agent: AI Score)
  aiScore           Float?       @map("ai_score") // AI-generated lead score (0-100)
  scoreBreakdown    Json?        @map("score_breakdown") // Details of score calculation
  lastScoredAt      DateTime?    @map("last_scored_at")
  
  // Assignment and Tracking
  assignedToId      Int?         @map("assigned_to_id")
  lastContactedAt   DateTime?    @map("last_contacted_at")
  nextFollowUpAt    DateTime?    @map("next_follow_up_at")
  
  // Metadata
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  
  // Relations
  assignedTo        User?        @relation(fields: [assignedToId], references: [id])
  activities        LeadActivity[]
  documents         LeadDocument[]

  @@map("leads")
}

enum ActivityType {
  email
  call
  meeting
  note
  task
  proposal_sent
  demo_scheduled
  contract_signed
  payment_received
  follow_up
  other
}

model LeadActivity {
  id          Int          @id @default(autoincrement())
  leadId      Int          @map("lead_id")
  type        ActivityType
  subject     String
  description String?
  scheduledAt DateTime?    @map("scheduled_at")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  // Relations
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model LeadDocument {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  filename    String
  originalName String  @map("original_name")
  mimeType    String   @map("mime_type")
  size        Int
  filePath    String   @map("file_path")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  
  // Relations
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_documents")
}

# Agent: Admin Panel - Subscription and Plan Management

enum PlanType {
  free
  basic
  professional
  enterprise
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  unpaid
  incomplete
  incomplete_expired
  trialing
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?
  type          PlanType
  price         Float         // Monthly price
  yearlyPrice   Float?        @map("yearly_price") // Yearly price (if applicable)
  features      Json          // List of features
  maxLeads      Int?          @map("max_leads") // Lead limit for this plan
  maxUsers      Int?          @map("max_users") // User limit for this plan
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  
  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id // Stripe subscription ID
  userId            Int                @map("user_id")
  planId            Int                @map("plan_id")
  status            SubscriptionStatus
  currentPeriodStart DateTime          @map("current_period_start")
  currentPeriodEnd   DateTime          @map("current_period_end")
  cancelAtPeriodEnd  Boolean           @default(false) @map("cancel_at_period_end")
  stripeCustomerId   String?           @map("stripe_customer_id")
  stripePriceId      String?           @map("stripe_price_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  
  // Relations
  user              User               @relation(fields: [userId], references: [id])
  plan              Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

# Add subscription relation to User model
model Database {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  host        String
  port        Int      @default(5432)
  username    String
  password    String   // This should be encrypted
  database    String
  ssl         Boolean  @default(false)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("databases")
}